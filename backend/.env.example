# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# External Services (Docker Compose)
# Start with: docker compose up -d
# =============================================================================

# PostgreSQL 16 with pgvector (container: driving_prep_postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/driving_prep
POSTGRES_DB=driving_prep
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis 7 (container: driving_prep_redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# =============================================================================
# External APIs (Cloud Services)
# =============================================================================

# OpenAI (not needed for MVP Sprint 1-2)
OPENAI_API_KEY=sk-placeholder
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# =============================================================================
# Application Config
# =============================================================================

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
